{
  "name": "stack-assignment",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev -p 3000 2>&1 | tee dev.log",
    "build": "node scripts/copy-pdf-worker.mjs && prisma generate && prisma db push --accept-data-loss && next build",
    "postinstall": "prisma generate && node scripts/copy-pdf-worker.mjs",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "lucide-react": "^0.525.0",
    "mammoth": "^1.12.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.11",
    "pdfjs-dist": "^5.4.624",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
