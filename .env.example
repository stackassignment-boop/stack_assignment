# Copy this file to `.env` in this same directory and fill in real values.
# `.env` itself is gitignored — never commit it.

# Neon Postgres. DATABASE_URL is the pooled connection used at runtime;
# DIRECT_URL is the non-pooled one Prisma needs for schema operations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# NextAuth. Set NEXTAUTH_URL to the site's own origin.
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# It must be a long random string — a guessable value lets anyone forge a
# session for any account, including admin.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"

# Google OAuth credentials from console.cloud.google.com
GOOGLE_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="REPLACE_ME"

# Vercel Blob store, read/write token
BLOB_READ_WRITE_TOKEN="REPLACE_ME"

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-REPLACEME"
